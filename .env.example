# WAAT 환경변수 템플릿 (실제 .env 파일은 .gitignore로 제외됨)
# 사용법: 이 파일을 .env로 복사한 후 실제 값으로 채우기

# Resend 이메일 발송
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=WAAT 운영자
RESEND_REPLY_TO=admin@example.com

# 알리고 SMS/알림톡
ALIGO_USER_ID=
ALIGO_API_KEY=
ALIGO_SENDER=

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PROJECT_REF=xxxxxxxxxxxx

# ---------- 앱 마켓 (/market · 콘솔 시스템 판매) — Vercel 환경변수에 동일 키로 입력 ----------
# 기존 판매 시스템(Claude 완벽가이드 sales-system)과 같은 키 이름. 값은 그쪽 .env 에서 옮긴다.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=16자리-앱-비밀번호
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...전체 JSON 한 줄..."}
SPREADSHEET_ID=스프레드시트-ID
JWT_SECRET=32자-이상-무작위-문자열
DOWNLOAD_TOKEN_EXPIRY_HOURS=24
MAX_DOWNLOAD_COUNT=5
BASE_URL=https://www.waat.community
SUPPORT_EMAIL=문의받을-이메일

# 출시 모드 — reserve(출시 전: 출시 알림 예약만, 기본) | sale(판매: 결제 UI). 출시 첫날 sale 로 바꾸고 scripts/notify-reservations.js 실행
PRODUCT_MODE=reserve

# 결제 안내 (화면에 그대로 표시)
PRODUCT_NAME=콘솔시스템 v1.0
PRODUCT_PRICE=9900
PRODUCT_VERSION=v1.0
KAKAOPAY_LINK=https://qr.kakaopay.com/xxxxxxxxx
BANK_NAME=은행명
BANK_ACCOUNT=계좌번호
BANK_HOLDER=예금주

# APK 위치 — 둘 중 하나 (APK_DOWNLOAD_URL 우선)
APK_DOWNLOAD_URL=https://.../consolesystem-v1.0.apk
APK_FILE_ID=구글드라이브-파일-ID

# 토스페이먼츠 카드 결제 (선택 — 둘 다 있을 때만 카드 결제 버튼 노출)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
