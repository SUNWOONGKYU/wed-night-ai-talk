# WAAT 환경변수 템플릿 (실제 .env 파일은 .gitignore로 제외됨)
# 사용법: 이 파일을 .env로 복사한 후 실제 값으로 채우기

# Resend 이메일 발송
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=WAAT 운영자
RESEND_REPLY_TO=admin@example.com

# 알리고 SMS/알림톡
ALIGO_USER_ID=
ALIGO_API_KEY=
ALIGO_SENDER=

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PROJECT_REF=xxxxxxxxxxxx

# ---------- 앱 마켓 (/market) — Google Sheets 미러링 (api/market/sheet-sync.js) ----------
# 정본은 Supabase app_orders. 시트는 복제본. 기존 판매 시스템(sales-system)과 같은 키 이름 — 값은 그쪽 .env 에서 옮긴다.
# Vercel Environment Variables 에 동일 키로 입력.
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...전체 JSON 한 줄..."}
SPREADSHEET_ID=스프레드시트-ID
# (선택) 기본값은 사이트 공개값
SUPABASE_ANON_KEY=
