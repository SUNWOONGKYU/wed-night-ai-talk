# claude-news-agent — 환경 변수 (인프라 B / .env 외부화 의무)
# 이 파일을 .env로 복사 후 실제 값으로 채우세요.
# .env는 git에 절대 커밋 금지 (.gitignore에 이미 포함).

# ── LLM 폴백 체인 (앞에서부터 시도. 키 없음·401·402·429·quota → 다음 provider) ──
LLM_FALLBACK_ORDER=anthropic,claude_cli,gemini,openai,grok

# ① Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ①-b Claude Code CLI (구독 기반 — API 크레딧 불필요. PC에 claude CLI 설치·로그인 필요)
# 키 불필요. 아래는 선택 항목 (기본값 사용 시 생략 가능)
# CLAUDE_CLI_PATH=          # 미지정 시 PATH에서 claude 탐색
# CLAUDE_CLI_MODEL=claude-sonnet-4-6
# CLAUDE_CLI_TIMEOUT_SEC=600

# ② Google Gemini  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# ③ OpenAI ChatGPT
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1

# ④ xAI Grok (https://console.x.ai)
GROK_API_KEY=xai-...
GROK_MODEL=grok-3
GROK_BASE_URL=https://api.x.ai/v1

# ── WAAT Supabase (글 게시 + 이미지 업로드) ──
# service_role_key는 RLS 우회 슈퍼키. 절대 클라이언트 노출 금지.
WAAT_SUPABASE_URL=https://vmiyqfkcoqdnkxjnxijt.supabase.co
WAAT_SUPABASE_SERVICE_ROLE_KEY=eyJ...
# PO admin user_id (Supabase Studio에서 auth.users 테이블 조회)
WAAT_BOT_USER_ID=3ed90e6e-94d1-42c0-b349-db9f7b504b12

# ── Gmail SMTP (PO 알림 이메일 발송) ──
# App Password 생성: https://myaccount.google.com/apppasswords
GMAIL_USER=wksun999@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_TO_EMAIL=wksun999@gmail.com

# ── 운영 파라미터 ──
POLL_INTERVAL_MINUTES=15
SELF_CRITIQUE_THRESHOLD=2
MAX_IMAGES_PER_POST=5
ANTHROPIC_NEWS_URL=https://www.anthropic.com/news
ANTHROPIC_RESEARCH_URL=https://www.anthropic.com/research
ANTHROPIC_SITEMAP_URL=https://www.anthropic.com/sitemap.xml
WAAT_CATEGORY=AI 새 소식
WAAT_STORAGE_BUCKET=post-images
